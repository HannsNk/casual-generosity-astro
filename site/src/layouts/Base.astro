---
import '../styles/global.css';
import AuthWidget from '../components/AuthWidget.astro';
import ShareWindow from '../components/ShareWindow.astro';


const { title, description, image } = Astro.props;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

// `image` may be an absolute external URL (activity photos) or left unset,
// in which case we fall back to a site-relative default — that one needs
// BASE_URL prepended since the site is served from a GitHub Pages subpath;
// an already-absolute URL passed to `image` is returned as-is by `new URL()`.
const shareImage = new URL(image ?? `${base}default-share-image.jpg`, Astro.site);

const NAV_LINKS = [
  { href: base, label: 'Home', match: '' },
  { href: `${base}activities.html`, label: 'Explore', match: 'activities' },
  { href: `${base}about.html`, label: 'About', match: 'about' },
  { href: `${base}notes.html`, label: 'Notes', match: 'notes' },
];

// Simple current-page check: does the path contain the section's segment?
// Home has no segment of its own, so it only matches the bare root path.
const isCurrent = (match: string) =>
  match === '' ? (path === base || path === `${base}index.html`) : path.includes(`/${match}`);

// The landing page shows its own large title in the masthead, so the nav
// bar's title stays hidden there until scrolling merges the two together.
const isLanding = isCurrent('');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>%E2%9D%A4%EF%B8%8F</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Space+Mono:wght@400;700&display=swap"
    />

    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "53dea8d7396246feaac67d970365e537"}'></script>
    <!-- End Cloudflare Web Analytics -->

  </head>
  <body class={isLanding ? 'is-landing' : undefined}>
    <nav class="sitenav">
      <div class="wrap sitenav-inner">
        <a class="sitenav-word" href={base}>CasuallyGenerous</a>
        <div class="sitenav-links">
          {NAV_LINKS.map((l) => (
            <a href={l.href} aria-current={isCurrent(l.match) ? 'page' : undefined}>{l.label}</a>
          ))}
        </div>
        <AuthWidget />
      </div>
    </nav>
    <script>
      // Keeps --nav-h in sync with the sticky nav's real height, so anything
      // that sticks below it (e.g. .filters on the activities page) can
      // offset by the right amount instead of a guessed pixel value.
      const nav = document.querySelector('.sitenav');
      if (nav) {
        const setNavHeight = () =>
          document.documentElement.style.setProperty('--nav-h', `${nav.getBoundingClientRect().height}px`);
        setNavHeight();
        new ResizeObserver(setNavHeight).observe(nav);
      }
    </script>
    <script>
      // On the landing page only: the nav bar's own title stays hidden while
      // the large masthead title is visible up top, and fades in (as the
      // masthead title shrinks away) once the page is scrolled — so the
      // title never appears twice at once.
      if (document.body.classList.contains('is-landing')) {
        const onScroll = () => {
          document.body.classList.toggle('scrolled', window.scrollY > 24);
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
    <slot />
    <ShareWindow />
    <footer class="foot">
      <div class="wrap">
        <p>
          CasuallyGenerous — a directory of small, mostly free things worth doing
          with the people you're already seeing.<br />
          Inspired by <em>Infectious Generosity</em> by Chris Anderson.
        </p>
        <p>
          Always confirm details directly with any organisation before turning up.
          Don't photograph people who haven't agreed to it.
        </p>
        <p><a href={`${base}privacy.html`}>Privacy</a></p>
        <p>
          These are suggestions, not professional advice — use your own judgement,
          especially for anything involving safety, first aid, or strangers.
          CasuallyGenerous isn't affiliated with the organisations or businesses
          mentioned, and we're not responsible for what happens once you head out
          the door.
        </p>
        <p class="foot-credit">Made with ❤️ by Hanns Niedermark</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // One delegated listener handles every [data-share] button on the page —
  // there can be dozens on the index grid, so we avoid per-button listeners.
  const timers = new WeakMap<HTMLButtonElement, number>();

  const flash = (btn: HTMLButtonElement, message: string) => {
    btn.dataset.feedback = message;
    btn.classList.add('shared');
    const prev = timers.get(btn);
    if (prev) window.clearTimeout(prev);
    timers.set(btn, window.setTimeout(() => btn.classList.remove('shared'), 1600));
  };

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-share]');
    if (!btn) return;

    const url = new URL(btn.dataset.url ?? '', location.href).href;
    const title = btn.dataset.title ?? document.title;
    const text = btn.dataset.text ?? '';

    if (navigator.share) {
      try {
        await navigator.share({ title, text, url });
      } catch {
        // user backed out of the share sheet — nothing to do
      }
      return;
    }

    try {
      await navigator.clipboard.writeText(url);
      flash(btn, 'Copied!');
    } catch {
      flash(btn, 'Copy failed');
    }
  });
</script>

<script>
  // Delegated handler for every [data-fav] heart button on the page (cards
  // and the detail page's "want to do" button alike), backed by the shared
  // in-memory favorites set in lib/favorites.js. toggleFavorite() updates
  // that set (and notifies onFavoritesChange subscribers, i.e. this script)
  // before its Firestore write resolves, so there's no need to re-apply
  // state here after awaiting it.
  import { onFavoritesChange, toggleFavorite } from '../lib/favorites.js';

  const applyFavState = (btn: HTMLButtonElement, active: boolean) => {
    btn.classList.toggle('is-fav', active);
    btn.setAttribute('aria-pressed', String(active));
    const label = btn.querySelector('.fav-label');
    if (label) label.textContent = active ? 'Saved' : 'Want to do';
  };

  onFavoritesChange((slugs: Set<string>) => {
    document.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((btn) => {
      applyFavState(btn, slugs.has(btn.dataset.slug ?? ''));
    });
  });

  // Brief "see it in your profile" hint after favoriting, same timed-flash
  // pattern as the share button's "Copied!" tooltip above.
  const favHintTimers = new WeakMap<HTMLButtonElement, number>();
  const flashSavedHint = (btn: HTMLButtonElement) => {
    btn.dataset.feedback = 'Saved! See it in your profile';
    btn.classList.add('fav-hint');
    const prev = favHintTimers.get(btn);
    if (prev) window.clearTimeout(prev);
    favHintTimers.set(btn, window.setTimeout(() => btn.classList.remove('fav-hint'), 2400));
  };

  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-fav]');
    if (!btn) return;
    const slug = btn.dataset.slug ?? '';
    if (!slug) return;
    const wasFavorited = await toggleFavorite(slug);
    if (wasFavorited === true) flashSavedHint(btn);
  });
</script>
