---
import '../styles/global.css';

const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Space+Mono:wght@400;700&display=swap"
    />
  </head>
  <body>
    <slot />
    <footer class="foot">
      <div class="wrap">
        <p>
          Casual Generosity — a directory of small, mostly free things worth doing
          with the people you're already seeing.<br />
          Inspired by <em>Infectious Generosity</em> by Chris Anderson.
        </p>
        <p>
          Always confirm details directly with any organisation before turning up.
          Don't photograph people who haven't agreed to it.
        </p>
      </div>
    </footer>
  </body>
</html>
