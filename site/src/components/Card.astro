---
import { Image } from 'astro:assets';

const { a, compact = false } = Astro.props;
const url = `${import.meta.env.BASE_URL}${a.slug}.html`;
const shareText = `Thought you'd like this: ${a.title} — ${a.hook}`;
---
<div
  class:list={['card', `t-${a.tier}`, compact && 'card--compact']}
  data-tier={a.tier}
  data-cost={a.cost.join('|')}
  data-group={a.groupSize.join('|')}
  data-time={a.timeBucket}
  data-tags={a.tags.join('|')}
>
  <a class="card-link" href={url} aria-label={a.title}></a>

  <div class="card-top">
    {a.image
      ? <Image class="card-img" src={a.image} inferSize alt="" loading="lazy" />
      : <div class="card-img placeholder">no photo</div>}
    {!compact && (
      <div class="meta">
        <span>{a.cost.join(' / ')}</span>
        <span>{a.time}</span>
        <span>{a.groupSize.join(', ')}</span>
      </div>
    )}
  </div>

  <div class="card-body">
    <div class="card-head">
      <span class="stamp">{a.tier}</span>
      <div class="card-actions">
        <button
          class="fav-btn icon-only"
          type="button"
          data-fav
          data-slug={a.slug}
          aria-pressed="false"
          aria-label={`Save ${a.title}`}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s-6.72-4.35-9.33-8.28C.87 9.94 1.62 6.4 4.5 5.09c2.1-.96 4.36-.2 5.5 1.6.35.56.6 1.02.6 1.02s.25-.46.6-1.02c1.14-1.8 3.4-2.56 5.5-1.6 2.88 1.31 3.63 4.85 1.83 7.63C18.72 16.65 12 21 12 21z"></path>
          </svg>
        </button>
        <button
          class="share-btn icon-only"
          type="button"
          data-share
          data-title={a.title}
          data-text={shareText}
          data-url={url}
          aria-label={`Share ${a.title}`}
        >
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line>
            <line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line>
          </svg>
        </button>
      </div>
    </div>
    <h2>{a.title}</h2>
    <p>{a.hook}</p>
  </div>
</div>
