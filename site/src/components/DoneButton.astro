---
const { a, url, compact = false } = Astro.props;
---
<button
  class:list={['done-btn', compact ? 'icon-only' : 'labeled']}
  type="button"
  data-done
  data-slug={a.slug}
  data-title={a.title}
  data-url={url}
  aria-pressed="false"
  aria-label={compact ? `Mark ${a.title} done` : undefined}
>
  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  {!compact && <span class="done-label">I have done this</span>}
</button>
