---
const base = import.meta.env.BASE_URL;
---
<div id="auth-widget" class="auth-widget">
  <button id="auth-signin" class="chip auth-trigger" type="button" aria-haspopup="dialog" aria-expanded="false">Sign in</button>

  <div id="auth-panel" class="auth-panel" role="dialog" aria-label="Sign in" hidden>
    <button id="auth-google" class="auth-google" type="button">
      <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.84.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.95v2.33A9 9 0 0 0 9 18z"/>
        <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.67 9c0-.59.1-1.17.28-1.7V4.97H.95A9 9 0 0 0 0 9c0 1.45.35 2.83.95 4.03l3-2.33z"/>
        <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .95 4.97l3 2.33C4.66 5.17 6.65 3.58 9 3.58z"/>
      </svg>
      Continue with Google
    </button>

    <div class="auth-divider"><span>or</span></div>

    <form id="auth-email-form" class="auth-email-form" novalidate>
      <input id="auth-email" type="email" placeholder="you@example.com" required autocomplete="email" />
      <input id="auth-password" type="password" placeholder="Password" required minlength="6" autocomplete="current-password" />
      <p class="auth-error" id="auth-error" hidden></p>
      <div class="auth-email-actions">
        <button type="submit" class="auth-submit">Sign in</button>
        <button type="button" id="auth-create" class="auth-link-btn">Create account</button>
      </div>
    </form>
  </div>

  <div id="auth-signedin" class="auth-signedin" hidden>
    <a href={`${base}profile.html`} class="auth-chip-user">
      <span id="auth-avatar" class="auth-avatar"></span>
      <span id="auth-name" class="auth-name"></span>
    </a>
    <button id="auth-signout" class="chip" type="button">Sign out</button>
  </div>
</div>

<style>
  /* margin-left: auto keeps the widget pinned to the right edge of
     .sitenav-inner even when it wraps onto its own line on narrow
     screens — without it, a lone item on a wrapped flex line falls
     back to flex-start (the left). */
  .auth-widget { position: relative; display: flex; align-items: center; margin-left: auto; }

  .auth-panel {
    position: absolute;
    top: calc(100% + .6rem);
    right: 0;
    z-index: 40;
    width: 260px;
    max-width: calc(100vw - 2rem);
    padding: 1rem;
    background: var(--card);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink-soft);
  }

  .auth-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    width: 100%;
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .02em;
    padding: .55em .7em;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: background .12s;
  }
  .auth-google:hover { background: var(--paper-deep); }
  .auth-google:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: .6rem;
    margin: .85rem 0;
    font-family: var(--mono);
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .auth-email-form { display: flex; flex-direction: column; gap: .55rem; }
  .auth-email-form input {
    width: 100%;
    font-family: var(--body);
    font-size: .85rem;
    color: var(--ink);
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 0;
    padding: .5em .65em;
  }
  .auth-email-form input:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }

  .auth-error {
    font-family: var(--mono);
    font-size: .66rem;
    color: var(--pink);
    margin: 0;
  }
  .auth-error[hidden] { display: none; }

  .auth-email-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
    margin-top: .1rem;
  }
  .auth-submit {
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .03em;
    padding: .5em .9em;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition: background .12s, border-color .12s;
  }
  .auth-submit:hover { background: var(--blue); border-color: var(--blue); }
  .auth-submit:focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  .auth-submit:disabled { opacity: .5; cursor: default; }

  .auth-link-btn {
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .01em;
    color: var(--ink-soft);
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .auth-link-btn:hover { color: var(--ink); }

  .auth-signedin { display: flex; align-items: center; gap: .6rem; }
  .auth-signedin[hidden] { display: none; }
  .auth-chip-user { display: flex; align-items: center; gap: .4rem; text-decoration: none; }
  .auth-avatar {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: .64rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
  }
  .auth-name {
    font-family: var(--mono);
    font-size: .72rem;
    color: var(--ink-soft);
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .auth-chip-user:hover .auth-name { color: var(--ink); }

  @media (max-width: 480px) {
    .auth-panel { width: 230px; }
    .auth-name { max-width: 5rem; }
  }
</style>

<script>
  import '../scripts/auth-widget.js';
</script>
