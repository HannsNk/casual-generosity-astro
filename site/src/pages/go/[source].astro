---
// Short redirect aliases (e.g. /go/ig) for links posted on other channels.
// Deliberately NOT Base.astro: no nav, no Cloudflare beacon, no arrival.js —
// the landing page logs the arrival once it sees ?ref={slug}.
import sources from '../../data/sources.json';

export function getStaticPaths() {
  return sources.map(({ slug, target }) => ({ params: { source: slug }, props: { slug, target } }));
}

const { slug, target } = Astro.props;

// BASE_URL keeps its trailing slash and targets start with one, so drop one
// side — with base '/', naive concatenation gives '//?ref=…', which browsers
// read as a protocol-relative URL to another host.
const targetPath = import.meta.env.BASE_URL.replace(/\/$/, '') + target;
const canonical = new URL(targetPath, Astro.site).href;
const dest = `${targetPath}${targetPath.includes('?') ? '&' : '?'}ref=${encodeURIComponent(slug)}`;
---
<!doctype html>
<html lang="en" data-dest={dest}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>CasuallyGenerous</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <script>
      import '../../scripts/go-redirect.js';
    </script>
  </head>
  <body>
    <p><a href={dest}>Continue to CasuallyGenerous</a></p>
  </body>
</html>
