---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import activities from '../../data/activities.json';

const base = import.meta.env.BASE_URL;
---
<Base
  title="Profile — CasuallyGenerous"
  description="Your CasuallyGenerous profile."
>
  <div class="wrap detail t-Committed">
    <div class="detail-top">
      <a class="back" href={base}>← Home</a>
    </div>

    <div class="detail-head">
      <h1>Profile</h1>
    </div>

    <section id="profile-loading" class="profile-state">
      <p>Loading…</p>
    </section>

    <section id="profile-signed-out" class="profile-state" hidden>
      <p>You're not signed in. Use the sign-in button in the nav to continue.</p>
    </section>

    <section id="profile-content" hidden>
      <div class="profile-card">
        <div id="profile-avatar" class="profile-avatar"></div>
        <div class="profile-info">
          <h2 id="profile-name"></h2>
          <p id="profile-email" class="profile-email"></p>
        </div>
        <button id="profile-signout" class="chip" type="button">Sign out</button>
      </div>

      <section class="profile-favorites">
        <h2>Saved</h2>
        <div class="grid" id="favorites-grid">
          {activities.map((a) => (
            <div class="fav-card" data-slug={a.slug} hidden>
              <Card a={a} compact />
            </div>
          ))}
        </div>
        <p class="favorites-empty" id="favorites-empty" hidden>
          Nothing saved yet — tap the heart on any activity to add it here.
        </p>
      </section>

      <section class="profile-done">
        <h2>Done</h2>
        <div class="grid" id="done-grid">
          {activities.map((a) => (
            <div class="done-card" data-slug={a.slug} hidden>
              <Card a={a} compact />
              <div class="done-meta">
                <p class="done-date" data-done-date></p>
                <p class="done-highlight" data-done-highlight hidden></p>
                <div class="done-tags" data-done-tags></div>
              </div>
            </div>
          ))}
        </div>
        <p class="done-empty" id="done-empty" hidden>
          Nothing marked done yet — tap "Done" on any activity once you've tried it.
        </p>
      </section>
    </section>
  </div>
</Base>

<script>
  import { auth, db } from '../../lib/firebase.js';
  import { onAuthStateChanged, signOut } from 'firebase/auth';
  import { collection, query, where, getDocs } from 'firebase/firestore';
  import { onFavoritesChange } from '../../lib/favorites.js';

  const loadingEl = document.getElementById('profile-loading') as HTMLElement;
  const signedOutEl = document.getElementById('profile-signed-out') as HTMLElement;
  const contentEl = document.getElementById('profile-content') as HTMLElement;
  const avatarEl = document.getElementById('profile-avatar') as HTMLElement;
  const nameEl = document.getElementById('profile-name') as HTMLElement;
  const emailEl = document.getElementById('profile-email') as HTMLElement;
  const signOutBtn = document.getElementById('profile-signout') as HTMLButtonElement;
  const favCards = [...document.querySelectorAll<HTMLElement>('.fav-card')];
  const favEmpty = document.getElementById('favorites-empty') as HTMLElement;

  onFavoritesChange((slugs: Set<string>) => {
    let shown = 0;
    favCards.forEach((card) => {
      const ok = slugs.has(card.dataset.slug ?? '');
      card.hidden = !ok;
      if (ok) shown++;
    });
    favEmpty.hidden = shown !== 0;
  });

  signOutBtn.addEventListener('click', () => signOut(auth));

  // ---------- done activities ----------

  const doneGrid = document.getElementById('done-grid') as HTMLElement;
  const doneEmpty = document.getElementById('done-empty') as HTMLElement;
  const doneCards = [...document.querySelectorAll<HTMLElement>('.done-card')];
  const doneCardBySlug = new Map(doneCards.map((c) => [c.dataset.slug ?? '', c]));

  const doneDateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

  type DoneRecord = { slug: string; doneAt: Date; highlight: string; withWho: string; reaction: string };

  const loadDone = async (uid: string) => {
    doneCards.forEach((card) => { card.hidden = true; });

    let records: DoneRecord[] = [];
    try {
      const q = query(
        collection(db, 'doneRecords'),
        where('uid', '==', uid),
        where('active', '==', true),
      );
      const snap = await getDocs(q);
      records = snap.docs.map((d) => {
        const data = d.data() as {
          activitySlug: string; doneAt?: { toDate(): Date }; highlight?: string; withWho?: string; reaction?: string;
        };
        return {
          slug: data.activitySlug,
          doneAt: data.doneAt?.toDate() ?? new Date(0),
          highlight: data.highlight ?? '',
          withWho: data.withWho ?? '',
          reaction: data.reaction ?? '',
        };
      });
    } catch (err) {
      console.error('Failed to load done activities', err);
    }

    // Most recently done first.
    records.sort((a, b) => b.doneAt.getTime() - a.doneAt.getTime());

    records.forEach((r) => {
      const card = doneCardBySlug.get(r.slug);
      if (!card) return;

      const dateEl = card.querySelector('[data-done-date]') as HTMLElement;
      const highlightEl = card.querySelector('[data-done-highlight]') as HTMLElement;
      const tagsEl = card.querySelector('[data-done-tags]') as HTMLElement;

      dateEl.textContent = doneDateFormat.format(r.doneAt);

      if (r.highlight) {
        highlightEl.textContent = `“${r.highlight}”`;
        highlightEl.hidden = false;
      } else {
        highlightEl.hidden = true;
      }

      tagsEl.innerHTML = '';
      [r.withWho, r.reaction].filter(Boolean).forEach((value) => {
        const span = document.createElement('span');
        span.className = 'done-stamp';
        span.textContent = value;
        tagsEl.append(span);
      });

      card.hidden = false;
      // Re-append in sorted order — moves the existing node rather than
      // cloning it, so the grid ends up ordered most-recent-first.
      doneGrid.append(card);
    });

    doneEmpty.hidden = records.length !== 0;
  };

  onAuthStateChanged(auth, (user) => {
    loadingEl.hidden = true;
    if (user) {
      signedOutEl.hidden = true;
      contentEl.hidden = false;

      const displayName = user.displayName ?? user.email ?? 'Anonymous';
      nameEl.textContent = displayName;
      emailEl.textContent = user.email ?? '';

      if (user.photoURL) {
        avatarEl.style.backgroundImage = `url(${user.photoURL})`;
        avatarEl.textContent = '';
      } else {
        avatarEl.style.backgroundImage = '';
        avatarEl.textContent = displayName.charAt(0).toUpperCase();
      }

      loadDone(user.uid);
    } else {
      contentEl.hidden = true;
      signedOutEl.hidden = false;
      doneCards.forEach((card) => { card.hidden = true; });
      doneEmpty.hidden = true;
    }
  });
</script>

<style>
  .profile-state {
    padding: 1.5rem 0 2.5rem;
    font-family: var(--mono);
    font-size: .85rem;
    color: var(--ink-soft);
  }

  .profile-card[hidden] { display: none; }
  .profile-card {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--card);
    border: var(--edge) solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink-soft);
    margin: 1.5rem 0 2.5rem;
  }

  .profile-avatar {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
  }

  .profile-info { flex: 1; min-width: 0; }
  .profile-info h2 {
    font-family: var(--display);
    font-size: 1.3rem;
    margin: 0 0 .25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .profile-email {
    font-family: var(--mono);
    font-size: .78rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .profile-favorites { margin-bottom: 4rem; }
  .profile-favorites > h2 {
    font-family: var(--mono);
    font-weight: 400;
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
    padding-bottom: .6rem;
    border-bottom: 1px solid var(--rule);
  }
  .favorites-empty {
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--ink-soft);
  }
  .favorites-empty[hidden] { display: none; }

  /* .grid stretches its direct children to equal row height by default, but
     that's .fav-card here, not the .card inside it — without this the .card
     boxes stay only as tall as their own content, so titles/descriptions of
     differing length leave cards visibly mismatched in height. */
  .fav-card { display: flex; }
  .fav-card[hidden] { display: none; }
  .fav-card .card { width: 100%; }

  .profile-done { margin-bottom: 4rem; }
  .profile-done > h2 {
    font-family: var(--mono);
    font-weight: 400;
    font-size: .68rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.25rem;
    padding-bottom: .6rem;
    border-bottom: 1px solid var(--rule);
  }
  .done-empty {
    font-family: var(--mono);
    font-size: .8rem;
    color: var(--ink-soft);
  }
  .done-empty[hidden] { display: none; }

  .done-card { display: flex; flex-direction: column; }
  .done-card[hidden] { display: none; }
  .done-card .card { width: 100%; }

  .done-meta {
    padding: .75rem 1rem 0;
  }
  .done-date {
    font-family: var(--mono);
    font-size: .66rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }
  .done-highlight {
    font-family: var(--body);
    font-style: italic;
    font-size: .9rem;
    line-height: 1.45;
    color: var(--ink);
    margin: .5rem 0 0;
  }
  .done-highlight[hidden] { display: none; }

  .done-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    margin-top: .6rem;
  }
  .done-tags:empty { display: none; }
  .done-stamp {
    font-family: var(--mono);
    font-size: .62rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    border: 2px solid var(--ink);
    color: var(--ink);
    padding: .28em .55em;
  }
</style>
