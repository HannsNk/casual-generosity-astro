---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import activities from '../../data/activities.json';

const TIERS = ['Spontaneous', 'Planned', 'Committed'];
const COSTS = ['Free', 'Under £20pp', '£20+pp'];
const GROUPS = ['Solo / Duo', 'Small Group (3-6)', 'Large Group (7+)'];
const TIMES = ['Under 30 min', '30-90 min', '90-120 min', 'Half-day'];
const TAGS = [...new Set(activities.flatMap((a) => a.tags))].sort((a, b) => a.localeCompare(b));

const TIER_NOTE = {
  Spontaneous: 'Do it today. Nothing to book, nothing to arrange.',
  Planned: 'Needs a date in the diary and a bit of coordinating.',
  Committed: 'Sign up, apply or train first — then it stays available to you.',
};

// Flattened, searchable text per activity (title, hook, why, instructions,
// tags and the rest of the metadata) — fed to Fuse.js client-side for a
// fuzzy full-text search across every field, not just the title.
const searchIndex = activities.map((a) => ({
  slug: a.slug,
  text: [
    a.title, a.hook, a.why, a.needs, a.instructions, a.link, a.tier, a.time,
    ...a.cost, ...a.groupSize, ...a.location, ...a.tags,
  ].filter(Boolean).join(' '),
}));
---
<Base
  title="Explore activities — CasuallyGenerous"
  description="A directory of 98 low-effort, mostly free ways to do something meaningful while hanging out with friends or a partner."
>
  <header class="masthead masthead-compact">
    <div class="wrap">
      <ul class="legend">
        {TIERS.map((t) => (
          <li class={`t-${t}`}>
            <b>{t}</b>
            <span>{TIER_NOTE[t]}</span>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <div class="filters">
    <div class="wrap search-row">
      <button type="button" class="search-toggle" id="search-toggle" aria-expanded="false" aria-controls="search-box">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
        </svg>
        Search
      </button>
      <div class="search-box" id="search-box" hidden>
        <input
          type="search"
          id="search-input"
          class="search-input"
          placeholder="Search activities…"
          aria-label="Search all activity details"
        />
      </div>
    </div>
    <div class="wrap filters-inner">
      <details class="filters-panel" id="filters-panel" open>
        <summary class="filters-toggle">Filters</summary>
        <div class="filters-body">
          <div class="fgroup">
            <span class="flabel">Effort</span>
            <div class="chip-row">
              {TIERS.map((t) => (
                <button class={`chip tier t-${t}`} data-facet="tier" data-value={t} aria-pressed="false">{t}</button>
              ))}
            </div>
            <select class="fselect" data-facet="tier" aria-label="Filter by effort">
              <option value="">All effort</option>
              {TIERS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Cost</span>
            <div class="chip-row">
              {COSTS.map((c) => (
                <button class="chip" data-facet="cost" data-value={c} aria-pressed="false">{c}</button>
              ))}
            </div>
            <select class="fselect" data-facet="cost" aria-label="Filter by cost">
              <option value="">All cost</option>
              {COSTS.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Time</span>
            <div class="chip-row">
              {TIMES.map((t) => (
                <button class="chip" data-facet="time" data-value={t} aria-pressed="false">{t}</button>
              ))}
            </div>
            <select class="fselect" data-facet="time" aria-label="Filter by time">
              <option value="">All time</option>
              {TIMES.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">People</span>
            <div class="chip-row">
              {GROUPS.map((g) => (
                <button class="chip" data-facet="group" data-value={g} aria-pressed="false">{g.replace(/ \(.*\)/, '')}</button>
              ))}
            </div>
            <select class="fselect" data-facet="group" aria-label="Filter by group size">
              <option value="">All group sizes</option>
              {GROUPS.map((g) => <option value={g}>{g}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Tags</span>
            <details class="tag-dropdown" id="tag-dropdown">
              <summary class="tag-dropdown-summary">
                <span id="tag-dropdown-label">All tags</span>
              </summary>
              <div class="tag-dropdown-panel chip-row">
                {TAGS.map((t) => (
                  <button class="chip" data-facet="tags" data-value={t} aria-pressed="false">{t}</button>
                ))}
              </div>
            </details>
            <select class="fselect" data-facet="tags" aria-label="Filter by tag">
              <option value="">All tags</option>
              {TAGS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Sort</span>
            <select class="sort-select" id="sort-select" aria-label="Sort activities">
              <option value="">Featured order</option>
              <option value="saved">Most saved</option>
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">View</span>
            <div class="view-toggle" id="view-toggle" role="group" aria-label="Grid columns">
              <button type="button" class="chip view-btn" data-cols="2" aria-pressed="false" aria-label="2 columns">
                <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><rect x="0" y="0" width="7" height="14" fill="currentColor" /><rect x="9" y="0" width="7" height="14" fill="currentColor" /></svg>
              </button>
              <button type="button" class="chip view-btn" data-cols="3" aria-pressed="false" aria-label="3 columns">
                <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><rect x="0" y="0" width="4" height="14" fill="currentColor" /><rect x="6" y="0" width="4" height="14" fill="currentColor" /><rect x="12" y="0" width="4" height="14" fill="currentColor" /></svg>
              </button>
              <button type="button" class="chip view-btn" data-cols="4" aria-pressed="false" aria-label="4 columns">
                <svg viewBox="0 0 16 14" width="16" height="14" aria-hidden="true"><rect x="0" y="0" width="2.8" height="14" fill="currentColor" /><rect x="4.4" y="0" width="2.8" height="14" fill="currentColor" /><rect x="8.8" y="0" width="2.8" height="14" fill="currentColor" /><rect x="13.2" y="0" width="2.8" height="14" fill="currentColor" /></svg>
              </button>
            </div>
          </div>
        </div>
      </details>
      <button class="reset" id="reset" hidden>Clear all</button>
      <output class="count" id="count">{activities.length} things to do</output>
    </div>
  </div>

  <main class="wrap">
    <div class="grid" id="grid">
      {activities.map((a) => <Card a={a} />)}
      <p class="empty" id="empty" hidden>
        Nothing matches all of those at once. Try clearing one filter.
      </p>
    </div>
  </main>

  <script is:inline type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
</Base>

<script>
  // Plain DOM filtering — no framework, ~1KB of JS on an otherwise static page.
  // .view-btn reuses .chip styling but isn't a filter facet, so it's excluded
  // here and handled by its own click listener further down.
  import Fuse from 'fuse.js';
  import { onStatsChange } from '../../lib/stats.js';

  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]')];
  const selects = [...document.querySelectorAll<HTMLSelectElement>('.fselect')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const reset = document.getElementById('reset') as HTMLButtonElement;
  const grid = document.getElementById('grid')!;
  const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('.view-btn')];
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchToggle = document.getElementById('search-toggle') as HTMLButtonElement | null;
  const searchBox = document.getElementById('search-box') as HTMLElement | null;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const tagDropdown = document.getElementById('tag-dropdown') as HTMLDetailsElement | null;
  const tagDropdownLabel = document.getElementById('tag-dropdown-label');

  const active: Record<string, Set<string>> = {
    tier: new Set(), cost: new Set(), time: new Set(), group: new Set(), tags: new Set(),
  };

  // null = no active search query, so filtering falls through untouched.
  let searchMatches: Set<string> | null = null;

  const matches = (card: HTMLElement) => {
    if (searchMatches && !searchMatches.has(card.dataset.slug ?? '')) return false;
    for (const facet of Object.keys(active)) {
      const wanted = active[facet];
      if (!wanted.size) continue;
      const raw = card.dataset[facet] ?? '';
      const has = raw.split('|').some((v) => wanted.has(v));
      if (!has) return false;
    }
    return true;
  };

  // Fuzzy full-text search over every field (title, hook, why, instructions,
  // tags, cost, time, group size, location — see `searchIndex` in the
  // frontmatter) rather than just the title, so a search for e.g. an
  // ingredient or a tag mentioned only in the instructions still hits.
  type SearchItem = { slug: string; text: string };
  const searchDataEl = document.getElementById('search-index');
  const searchCorpus: SearchItem[] = searchDataEl ? JSON.parse(searchDataEl.textContent ?? '[]') : [];
  const fuse = new Fuse(searchCorpus, {
    keys: ['text'],
    threshold: 0.35,
    ignoreLocation: true,
    minMatchCharLength: 2,
  });

  const runSearch = (query: string) => {
    const q = query.trim();
    searchMatches = q ? new Set(fuse.search(q).map((r) => r.item.slug)) : null;
    searchToggle?.classList.toggle('has-query', q.length > 0);
    apply();
  };

  let searchTimer: ReturnType<typeof setTimeout> | undefined;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => runSearch(searchInput.value), 120);
  });

  // The search box stays collapsed behind the toggle button until opened,
  // to keep the filter bar compact — same idea as the mobile filters panel.
  const openSearch = () => {
    if (!searchBox || !searchToggle) return;
    searchBox.hidden = false;
    searchToggle.setAttribute('aria-expanded', 'true');
    searchInput?.focus();
  };
  const closeSearch = () => {
    if (!searchBox || !searchToggle) return;
    searchBox.hidden = true;
    searchToggle.setAttribute('aria-expanded', 'false');
  };
  searchToggle?.addEventListener('click', () => {
    (searchBox?.hidden ?? true) ? openSearch() : closeSearch();
  });

  // Sort-by-saved reorders the actual card DOM nodes; "Featured order" just
  // leaves them in their build-time order (tier/Airtable order) untouched.
  // Save counts load asynchronously from Firestore (see lib/stats.js), so
  // this re-sorts again whenever that data (or a live save/unsave) arrives.
  let statsMap = new Map<string, number>();
  const sortCards = () => {
    if (sortSelect?.value !== 'saved') return;
    const sorted = [...cards].sort((a, b) => {
      const bv = statsMap.get(b.dataset.slug ?? '') ?? 0;
      const av = statsMap.get(a.dataset.slug ?? '') ?? 0;
      return bv - av;
    });
    sorted.forEach((card) => grid.appendChild(card));
  };
  sortSelect?.addEventListener('change', sortCards);
  onStatsChange((stats) => {
    statsMap = new Map([...stats].map(([slug, s]) => [slug, s.saveCount]));
    sortCards();
  });

  // Keep chips and the mobile <select> for the same facet in sync, since
  // either can be used to change the filter depending on viewport width.
  const syncControls = () => {
    chips.forEach((chip) => {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      chip.setAttribute('aria-pressed', String(active[facet].has(value)));
    });
    selects.forEach((select) => {
      const facet = select.dataset.facet!;
      const set = active[facet];
      select.value = set.size ? [...set][set.size - 1] : '';
    });
    if (tagDropdownLabel) {
      const n = active.tags.size;
      tagDropdownLabel.textContent = n ? `${n} tag${n > 1 ? 's' : ''}` : 'All tags';
      tagDropdown?.classList.toggle('has-selection', n > 0);
    }
  };

  const apply = () => {
    let shown = 0;
    for (const card of cards) {
      const ok = matches(card);
      card.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = shown === cards.length
      ? `${shown} things to do`
      : `${shown} of ${cards.length}`;
    empty.hidden = shown !== 0;
    const any = Object.values(active).some((s) => s.size > 0) || searchMatches !== null;
    reset.hidden = !any;
  };

  // Pre-fill filters from the URL's query string (?tier=&cost=&time=&group=&tags=&q=)
  // so a link like /activities/?tier=Spontaneous lands already filtered.
  // Facet values are matched against their chip's data-value; a value with
  // no matching chip is ignored silently.
  const applyParamsToChips = () => {
    const params = new URLSearchParams(window.location.search);
    const facetParams: [string, string][] = [
      ['tier', 'tier'], ['cost', 'cost'], ['time', 'time'], ['group', 'group'], ['tags', 'tags'],
    ];

    for (const [param, facet] of facetParams) {
      const raw = params.get(param);
      if (!raw) continue;
      for (const value of raw.split(',').map((v) => v.trim()).filter(Boolean)) {
        const chip = chips.find((c) => c.dataset.facet === facet && c.dataset.value === value);
        if (!chip) continue;
        chip.setAttribute('aria-pressed', 'true');
        active[facet].add(value);
      }
    }

    const q = params.get('q');
    if (q && searchInput) searchInput.value = q;
  };

  applyParamsToChips();
  syncControls();
  runSearch(searchInput?.value ?? '');
  // A query loaded from the URL (?q=) should land with the box open, not
  // hidden behind the toggle with an invisible active filter.
  if (searchInput?.value) openSearch();

  // Close the tag popover on an outside click, same as any dropdown.
  document.addEventListener('click', (e) => {
    if (tagDropdown?.open && !tagDropdown.contains(e.target as Node)) {
      tagDropdown.open = false;
    }
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      const set = active[facet];
      const on = set.has(value);
      on ? set.delete(value) : set.add(value);
      syncControls();
      apply();
    });
  });

  const filtersPanel = document.getElementById('filters-panel') as HTMLDetailsElement;
  const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

  // The <details> markup ships permanently `open` — desktop relies on that
  // (its content must never be collapsed, and closing a <details> natively
  // hides everything but the <summary>, which desktop can't tolerate) — so
  // mobile has to close it itself on load instead of via a default state.
  if (isMobile()) filtersPanel.open = false;

  selects.forEach((select) => {
    select.addEventListener('change', () => {
      const facet = select.dataset.facet!;
      active[facet].clear();
      if (select.value) active[facet].add(select.value);
      syncControls();
      apply();
      // On mobile the panel is a dropdown overlay — collapse it back to a
      // single "Filters" row as soon as a choice is made, so results show.
      if (isMobile()) filtersPanel.open = false;
    });
  });

  reset.addEventListener('click', () => {
    Object.values(active).forEach((s) => s.clear());
    if (searchInput) searchInput.value = '';
    searchMatches = null;
    searchToggle?.classList.remove('has-query');
    closeSearch();
    if (tagDropdown) tagDropdown.open = false;
    syncControls();
    apply();
  });

  // Grid column count: 2/3/4-wide, remembered across visits. A toggle group
  // like the facet chips, not a single-select — clicking the active button
  // again clears back to auto, same as clicking a pressed filter chip twice.
  const COLS_KEY = 'cg-grid-cols';
  const applyCols = (v: string) => {
    grid.classList.toggle('cols-2', v === '2');
    grid.classList.toggle('cols-3', v === '3');
    grid.classList.toggle('cols-4', v === '4');
    viewButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cols === v)));
  };

  applyCols(localStorage.getItem(COLS_KEY) ?? '');

  viewButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const wasActive = btn.getAttribute('aria-pressed') === 'true';
      const v = wasActive ? '' : (btn.dataset.cols ?? '');
      applyCols(v);
      localStorage.setItem(COLS_KEY, v);
    });
  });
</script>
