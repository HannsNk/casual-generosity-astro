---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import activities from '../../data/activities.json';

const TIERS = ['Spontaneous', 'Planned', 'Committed'];
const COSTS = ['Free', 'Under £20pp', '£20+pp'];
const GROUPS = ['Solo / Duo', 'Small Group (3-6)', 'Large Group (7+)'];
const TIMES = ['Under 30 min', '30-90 min', '90-120 min', 'Half-day'];

const TIER_NOTE = {
  Spontaneous: 'Do it today. Nothing to book, nothing to arrange.',
  Planned: 'Needs a date in the diary and a bit of coordinating.',
  Committed: 'Sign up, apply or train first — then it stays available to you.',
};
---
<Base
  title="Explore activities — CasuallyGenerous"
  description="A directory of 98 low-effort, mostly free ways to do something meaningful while hanging out with friends or a partner."
>
  <header class="masthead">
    <div class="wrap">
      <ul class="legend">
        {TIERS.map((t) => (
          <li class={`t-${t}`}>
            <b>{t}</b>
            <span>{TIER_NOTE[t]}</span>
          </li>
        ))}
      </ul>
    </div>
  </header>

  <div class="filters">
    <div class="wrap filters-inner">
      <details class="filters-panel" id="filters-panel" open>
        <summary class="filters-toggle">Filters</summary>
        <div class="filters-body">
          <div class="fgroup">
            <span class="flabel">Effort</span>
            <div class="chip-row">
              {TIERS.map((t) => (
                <button class={`chip tier t-${t}`} data-facet="tier" data-value={t} aria-pressed="false">{t}</button>
              ))}
            </div>
            <select class="fselect" data-facet="tier" aria-label="Filter by effort">
              <option value="">All effort</option>
              {TIERS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Cost</span>
            <div class="chip-row">
              {COSTS.map((c) => (
                <button class="chip" data-facet="cost" data-value={c} aria-pressed="false">{c}</button>
              ))}
            </div>
            <select class="fselect" data-facet="cost" aria-label="Filter by cost">
              <option value="">All cost</option>
              {COSTS.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">Time</span>
            <div class="chip-row">
              {TIMES.map((t) => (
                <button class="chip" data-facet="time" data-value={t} aria-pressed="false">{t}</button>
              ))}
            </div>
            <select class="fselect" data-facet="time" aria-label="Filter by time">
              <option value="">All time</option>
              {TIMES.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">People</span>
            <div class="chip-row">
              {GROUPS.map((g) => (
                <button class="chip" data-facet="group" data-value={g} aria-pressed="false">{g.replace(/ \(.*\)/, '')}</button>
              ))}
            </div>
            <select class="fselect" data-facet="group" aria-label="Filter by group size">
              <option value="">All group sizes</option>
              {GROUPS.map((g) => <option value={g}>{g}</option>)}
            </select>
          </div>
          <div class="fgroup">
            <span class="flabel">View</span>
            <select class="cols-select" id="cols-select" aria-label="Grid columns">
              <option value="">Auto</option>
              <option value="2">2-wide</option>
              <option value="3">3-wide</option>
              <option value="4">4-wide</option>
            </select>
          </div>
        </div>
      </details>
      <button class="reset" id="reset" hidden>Clear all</button>
      <output class="count" id="count">{activities.length} things to do</output>
    </div>
  </div>

  <main class="wrap">
    <div class="grid" id="grid">
      {activities.map((a) => <Card a={a} />)}
      <p class="empty" id="empty" hidden>
        Nothing matches all of those at once. Try clearing one filter.
      </p>
    </div>
  </main>
</Base>

<script>
  // Plain DOM filtering — no framework, ~1KB of JS on an otherwise static page.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const selects = [...document.querySelectorAll<HTMLSelectElement>('.fselect')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const reset = document.getElementById('reset') as HTMLButtonElement;
  const grid = document.getElementById('grid')!;
  const colsSelect = document.getElementById('cols-select') as HTMLSelectElement;

  const active: Record<string, Set<string>> = {
    tier: new Set(), cost: new Set(), time: new Set(), group: new Set(), tags: new Set(),
  };

  const matches = (card: HTMLElement) => {
    for (const facet of Object.keys(active)) {
      const wanted = active[facet];
      if (!wanted.size) continue;
      const raw = card.dataset[facet] ?? '';
      const has = raw.split('|').some((v) => wanted.has(v));
      if (!has) return false;
    }
    return true;
  };

  // Keep chips and the mobile <select> for the same facet in sync, since
  // either can be used to change the filter depending on viewport width.
  const syncControls = () => {
    chips.forEach((chip) => {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      chip.setAttribute('aria-pressed', String(active[facet].has(value)));
    });
    selects.forEach((select) => {
      const facet = select.dataset.facet!;
      const set = active[facet];
      select.value = set.size ? [...set][set.size - 1] : '';
    });
  };

  const apply = () => {
    let shown = 0;
    for (const card of cards) {
      const ok = matches(card);
      card.hidden = !ok;
      if (ok) shown++;
    }
    count.textContent = shown === cards.length
      ? `${shown} things to do`
      : `${shown} of ${cards.length}`;
    empty.hidden = shown !== 0;
    const any = Object.values(active).some((s) => s.size > 0);
    reset.hidden = !any;
  };

  // Pre-fill filters from the URL's query string (?tier=&cost=&time=&group=&tags=)
  // so a link like /activities/?tier=Spontaneous lands already filtered.
  // tier/cost/time/group are matched against their chip's data-value; a value
  // with no matching chip is ignored silently. tags has no chip UI on this
  // page, so it's matched directly against each card's data-tags instead.
  const applyParamsToChips = () => {
    const params = new URLSearchParams(window.location.search);
    const facetParams: [string, string][] = [
      ['tier', 'tier'], ['cost', 'cost'], ['time', 'time'], ['group', 'group'],
    ];

    for (const [param, facet] of facetParams) {
      const raw = params.get(param);
      if (!raw) continue;
      for (const value of raw.split(',').map((v) => v.trim()).filter(Boolean)) {
        const chip = chips.find((c) => c.dataset.facet === facet && c.dataset.value === value);
        if (!chip) continue;
        chip.setAttribute('aria-pressed', 'true');
        active[facet].add(value);
      }
    }

    const tagsRaw = params.get('tags');
    if (tagsRaw) {
      const knownTags = new Set(cards.flatMap((c) => (c.dataset.tags ?? '').split('|')));
      for (const value of tagsRaw.split(',').map((v) => v.trim()).filter(Boolean)) {
        if (knownTags.has(value)) active.tags.add(value);
      }
    }
  };

  applyParamsToChips();
  syncControls();
  apply();

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      const set = active[facet];
      const on = set.has(value);
      on ? set.delete(value) : set.add(value);
      syncControls();
      apply();
    });
  });

  const filtersPanel = document.getElementById('filters-panel') as HTMLDetailsElement;
  const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

  // The <details> markup ships permanently `open` — desktop relies on that
  // (its content must never be collapsed, and closing a <details> natively
  // hides everything but the <summary>, which desktop can't tolerate) — so
  // mobile has to close it itself on load instead of via a default state.
  if (isMobile()) filtersPanel.open = false;

  selects.forEach((select) => {
    select.addEventListener('change', () => {
      const facet = select.dataset.facet!;
      active[facet].clear();
      if (select.value) active[facet].add(select.value);
      syncControls();
      apply();
      // On mobile the panel is a dropdown overlay — collapse it back to a
      // single "Filters" row as soon as a choice is made, so results show.
      if (isMobile()) filtersPanel.open = false;
    });
  });

  reset.addEventListener('click', () => {
    Object.values(active).forEach((s) => s.clear());
    syncControls();
    apply();
  });

  // Grid column count: 2/3/4-wide, remembered across visits.
  const COLS_KEY = 'cg-grid-cols';
  const savedCols = localStorage.getItem(COLS_KEY) ?? '';
  colsSelect.value = savedCols;
  grid.classList.toggle('cols-2', savedCols === '2');
  grid.classList.toggle('cols-3', savedCols === '3');
  grid.classList.toggle('cols-4', savedCols === '4');

  colsSelect.addEventListener('change', () => {
    const v = colsSelect.value;
    grid.classList.toggle('cols-2', v === '2');
    grid.classList.toggle('cols-3', v === '3');
    grid.classList.toggle('cols-4', v === '4');
    localStorage.setItem(COLS_KEY, v);
  });
</script>
