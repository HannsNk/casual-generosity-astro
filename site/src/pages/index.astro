---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import activities from '../data/activities.json';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Placeholder until a live Firestore count query replaces it.
const thingsDone = 0;

// Hand-picked, not derived from any ranking — update this list manually
// whenever you want to change what the homepage recommends.
const featuredSlugs = [
  'write-an-appreciation-email-to-an-old-teacher',
  'donate-blood-together',
  'do-a-first-aid-course-together',
];
const featured = featuredSlugs
  .map((slug) => activities.find((a) => a.slug === slug))
  .filter((a) => a !== undefined);

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
const latestNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const INTENTS = [
  {
    tier: 'Spontaneous',
    href: `${base}activities.html?tier=Spontaneous`,
    label: 'Do something right now',
    sub: 'No planning, no cost, just today.',
  },
  {
    tier: 'Planned',
    href: `${base}activities.html?tier=Planned`,
    label: 'Plan something together',
    sub: 'A bit of coordinating, worth the effort.',
  },
  {
    tier: null,
    href: `${base}activities.html?tags=Preparedness`,
    label: 'Get ready to help later',
    sub: 'Skills and habits that sit ready until you need them.',
  },
  {
    tier: null,
    href: `${base}activities.html`,
    label: 'See everything',
    sub: 'Browse the full list, filter as you go.',
  },
];
---
<Base
  title="CasuallyGenerous — easy, good things to do with people you're already seeing"
  description="A directory of low-effort, mostly free ways to do something meaningful while hanging out with friends or a partner."
>
  <div class="landing">
    <header class="masthead">
      <div class="wrap">
        <h1 class="wordmark">CasuallyGenerous</h1>
        <p class="landing-pitch">
          Small, mostly free things worth doing with the people you're already
          seeing this week. Pick what fits your moment.
        </p>
      </div>
    </header>

    <section class="intent wrap">
      <p class="intent-label">Where do you want to start?</p>
      <div class="intent-grid">
        {INTENTS.map((i) => (
          <a class:list={['intent-card', i.tier ? `t-${i.tier}` : 'neutral']} href={i.href}>
            <span class="intent-card-label">{i.label}</span>
            <span class="intent-card-sub">{i.sub}</span>
            <span class="intent-card-arrow">→</span>
          </a>
        ))}
      </div>
      <p class="stats-counter"><b>{thingsDone}</b> things done so far</p>
    </section>

    {featured.length > 0 && (
      <section class="wrap landing-section">
        <p class="intent-label">Where to start</p>
        <p class="landing-pitch">A few we'd genuinely recommend.</p>
        <div class="grid">
          {featured.map((a) => <Card a={a} />)}
        </div>
      </section>
    )}

    {latestNotes.length > 0 && (
      <section class="wrap landing-section">
        <p class="intent-label">Notes</p>
        <p class="landing-pitch">Occasional writing, with a few activities worth trying alongside it.</p>
        <ul class="notes-index">
          {latestNotes.map((post) => (
            <li class="notes-index-item">
              <a href={`${base}notes/${post.id}.html`}>
                <span class="notes-index-date">{dateFmt.format(post.data.date)}</span>
                <h2>{post.data.title}</h2>
                {post.data.description && <p>{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="landing-why wrap">
      <h2>Why this exists</h2>
      <p>
        This isn't volunteering, and it isn't a donation platform — plenty of
        good options exist for both. This is something else: the small,
        overlooked, mostly free stuff that fits into a life you're already
        living.
      </p>
      <a href={`${base}about.html`}>More on why →</a>
    </section>
  </div>
</Base>
