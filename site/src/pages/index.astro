---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import activities from '../data/activities.json';
import { getCollection, type CollectionEntry } from 'astro:content';

const base = import.meta.env.BASE_URL;

const TIERS = [
  {
    key: 'Spontaneous',
    index: '01',
    headline: "Whatever time you have right now.",
    body: 'No planning, no cost. Something you could start in the next ten minutes.',
  },
  {
    key: 'Planned',
    index: '02',
    headline: 'Worth putting in the diary.',
    body: "A bit of coordinating — an evening, a weekend morning — with someone it's worth making time for.",
  },
  {
    key: 'Committed',
    index: '03',
    headline: 'Worth signing up for properly.',
    body: "A form, a booking or a training, then it's yours to come back to. Better with someone alongside you.",
  },
];

// Temporary manual curation: list up to 3 activity slugs per tier here to
// pin exactly which cards show on the landing page, in that order. Leave a
// tier's array empty to fall back to the default (first 3 in tier order).
const FEATURED_SLUGS: Record<string, string[]> = {
  Spontaneous: ['write-an-appreciation-email-to-an-old-teacher', 'learn-basic-sign-language', 'classify-images-for-real-scientific-research'],
  Planned: ['write-to-a-neighbour-offering-your-help-as-a-group', 'donate-blood-together', 'run-a-plastic-free-picnic'],
  Committed: ['do-a-first-aid-course-together', 'spend-an-afternoon-at-a-senior-living-home', 'take-a-dog-out-for-the-day'],
};

const bands = TIERS.map((tier) => {
  const tierActivities = activities.filter((a) => a.tier === tier.key);
  const featured = (FEATURED_SLUGS[tier.key] ?? [])
    .map((slug) => tierActivities.find((a) => a.slug === slug))
    .filter((a): a is typeof tierActivities[number] => Boolean(a));
  return {
    ...tier,
    count: tierActivities.length,
    activities: featured.length ? featured.slice(0, 3) : tierActivities.slice(0, 3),
  };
});

const dateFmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
const latestNotes = (await getCollection('notes'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base
  title="CasuallyGenerous — easy, good things to do with people you're already seeing"
  description="A directory of low-effort, mostly free ways to do something meaningful while hanging out with friends or a partner."
>
  <section class="fold">
    <div class="wrap">
      <p class="fold-eyebrow">Welcome to CasuallyGenerous</p>
      <h1 class="fold-title">Be generous in your every day social plans.</h1>
      <p class="fold-deck">
        Free, or nearly free. Small enough to fit into a life you're already
        living, not a separate slot for "doing good." Sorted below by how
        much you've got to give this week.
      </p>
    </div>
  </section>

  {bands.map((band, i) => (
    <section class:list={['tier-band', `t-${band.key}`, i === 1 && 'tier-band--right']}>
      <div class="tier-panel">
        <p class="tier-index">{band.index} — {band.key.toUpperCase()}</p>
        <h2 class="tier-headline">{band.headline}</h2>
        <p class="tier-body">{band.body}</p>
        <a class="tier-link" href={`${base}activities.html?tier=${band.key}`}>
          ALL {band.count} {band.key.toUpperCase()} →
        </a>
      </div>
      <div class="tier-cards grid cols-3">
        {band.activities.map((a) => (
          <Card a={a} headingLevel="h3" />
        ))}
      </div>
    </section>
  ))}

  <section class="split-cta">
    <a class="split-cta-block split-cta-block--dark" href={`${base}activities.html`}>
      <span class="split-cta-eyebrow">EXPLORE</span>
      <span class="split-cta-title">All {activities.length} activities →</span>
    </a>
    <a class="split-cta-block" href={`${base}about.html`}>
      <span class="split-cta-eyebrow">LEARN MORE</span>
      <span class="split-cta-title">Why this exists →</span>
    </a>
  </section>

  <section class="generous">
    <div class="wrap">
      <p class="generous-eyebrow">Feeling generous toward this project?</p>
      <p class="generous-intro">
        This is a small side project, not a business — if you want to help it
        grow, here's what actually helps.
      </p>
      <div class="generous-grid">
        <div class="generous-item t-Spontaneous">
          <p class="generous-item-label">Share it</p>
          <p>
            Pass the whole page along, or send someone the one activity that
            made you think of them. That's genuinely the whole model working.
          </p>
        </div>
        <div class="generous-item t-Planned">
          <p class="generous-item-label">Send an idea or a correction</p>
          <p>
            Spotted something wrong, got a suggestion, or know an activity
            that deserves a place here?
          </p>
          <a href={`${base}about.html`}>Get in touch →</a>
        </div>
        <div class="generous-item t-Committed">
          <p class="generous-item-label">Help build it</p>
          <p>Comfortable with code and see something that could work better?</p>
          <a href="https://github.com/HannsNk/casual-generosity-astro">It's on GitHub →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
