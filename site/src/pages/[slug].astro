---
import Base from '../layouts/Base.astro';
import activities from '../data/activities.json';
import { Image } from 'astro:assets';
import DoneButton from '../components/DoneButton.astro';

export function getStaticPaths() {
  return activities.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;

// Instructions arrive as plain text: blank lines separate blocks, and a block
// whose lines all begin with "- " is a list.
const blocks = a.instructions.split(/\n\s*\n/).map((raw) => {
  const lines = raw.split('\n').map((l) => l.trim()).filter(Boolean);
  const isList = lines.length > 0 && lines.every((l) => l.startsWith('- '));
  return isList
    ? { type: 'ul' as const, items: lines.map((l) => l.slice(2)) }
    : { type: 'p' as const, text: lines.join(' ') };
});

const href = a.link && !a.link.startsWith('Search:')
  ? (a.link.startsWith('http') ? a.link : `https://${a.link}`)
  : null;

const shareText = `Thought you'd like this: ${a.title} — ${a.hook}`;
---
<Base title={`${a.title} — CasuallyGenerous`} description={a.hook} image={a.image || undefined}>
  <div class={`wrap detail t-${a.tier}`}>
    
    {a.image && <Image class="hero" src={a.image} inferSize alt="" />}
    
    <div class="detail-top">
      <a class="back" href={`${import.meta.env.BASE_URL}activities.html`}>← All activities</a>
      <div class="detail-actions">
        <DoneButton a={a} url={`${import.meta.env.BASE_URL}${a.slug}.html`} />
        <button
          class="fav-btn labeled"
          type="button"
          data-fav
          data-slug={a.slug}
          aria-pressed="false"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s-6.72-4.35-9.33-8.28C.87 9.94 1.62 6.4 4.5 5.09c2.1-.96 4.36-.2 5.5 1.6.35.56.6 1.02.6 1.02s.25-.46.6-1.02c1.14-1.8 3.4-2.56 5.5-1.6 2.88 1.31 3.63 4.85 1.83 7.63C18.72 16.65 12 21 12 21z"></path>
          </svg>
          <span class="fav-label">Want to do</span>
        </button>
        <button
          class="share-btn labeled"
          type="button"
          data-share
          data-title={a.title}
          data-text={shareText}
          data-url={`${import.meta.env.BASE_URL}${a.slug}.html`}
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line>
            <line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line>
          </svg>
          <span>Share</span>
        </button>
      </div>
    </div>

    <p class="detail-counts">
      <span class="save-count" id="save-count" data-slug={a.slug} hidden>0 saved</span>
      <span class="done-count" id="done-count" data-slug={a.slug}>Be the first person to do this!</span>
    </p>

    <div class="detail-head">
      <span class="stamp">{a.tier}</span>
      <h1>{a.title}</h1>
      <p class="detail-hook">{a.hook}</p>
    </div>

    <dl class="spec">
      <div><dt>Cost</dt><dd>{a.cost.join(' / ')}</dd></div>
      <div><dt>Time</dt><dd>{a.time}</dd></div>
      <div><dt>People</dt><dd>{a.groupSize.join(', ')}</dd></div>
      <div><dt>Where</dt><dd>{a.location.join(', ')}</dd></div>
      <div><dt>Bring</dt><dd>{a.needs || 'Nothing in particular'}</dd></div>
    </dl>

    <section class="why">
      <h2>Why this matters</h2>
      <p>{a.why}</p>
    </section>

    <section class="howto">
      <h2>How to do it</h2>
      {blocks.map((b) =>
        b.type === 'ul'
          ? <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
          : <p>{b.text}</p>
      )}

      {a.link && (
        <p>
          {href
            ? <a class="orglink" href={href} target="_blank" rel="noopener">{a.link} ↗</a>
            : <span class="orglink">{a.link}</span>}
        </p>
      )}

      <div class="taglist">
        {a.tags.map((t) => <span>{t}</span>)}
      </div>
    </section>
  </div>
</Base>
