---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---
<Base
  title="Page not found — CasuallyGenerous"
  description="This page doesn't exist. Head back to the full list of activities."
>
  <div class="wrap not-found">
    <p class="not-found-label">404</p>
    <h1>Page not found</h1>
    <p class="not-found-text">
      That link's broken, or the page has moved. Nothing to worry about —
      there's still a whole list of things to do.
    </p>
    <a class="back" href={`${import.meta.env.BASE_URL}activities.html`}>← Back to all activities</a>
  </div>
</Base>
