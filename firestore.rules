rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validDocId(docId, uid, slug) {
      return docId == uid + '_' + slug;
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if isOwner(uid);
    }

    // Public fact: what a user's relationship to an activity is right now.
    // No personal content lives here — safe to be fully public-read and
    // safe to run count() aggregation queries against.
    match /activityInteractions/{docId} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.uid)
        && validDocId(docId, request.resource.data.uid, request.resource.data.activitySlug)
        && request.resource.data.activitySlug is string
        && request.resource.data.state in ['favorited', 'done'];

      allow update: if isOwner(resource.data.uid)
        && isOwner(request.resource.data.uid)
        && resource.data.uid == request.resource.data.uid
        && resource.data.activitySlug == request.resource.data.activitySlug
        && request.resource.data.state in ['favorited', 'done'];

      // Needed for Undo (deletes the fact) — deliberately NOT needed for
      // account-deletion cleanup, since these should survive account deletion.
      allow delete: if isOwner(resource.data.uid);
    }

    // Private detail: only ever exists alongside a 'done' state, holds the
    // free-text/personal fields. Owner-only in every direction, including
    // delete — required for account-deletion cleanup.
    match /doneDetails/{docId} {
      allow read: if isOwner(resource.data.uid);

      allow create: if isOwner(request.resource.data.uid)
        && validDocId(docId, request.resource.data.uid, request.resource.data.activitySlug)
        && request.resource.data.activitySlug is string;

      allow update: if isOwner(resource.data.uid)
        && isOwner(request.resource.data.uid)
        && resource.data.uid == request.resource.data.uid;

      allow delete: if isOwner(resource.data.uid);
    }
  }
}
