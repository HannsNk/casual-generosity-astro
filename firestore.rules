rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // activityStats has two independent counters (doneCount, saveCount).
    // A single write may touch either or both (marking an activity done
    // that was previously favorited moves both in the same batch write),
    // but each one that's present may only move by exactly +1 or -1 from
    // its prior value — resource is null on create, so "before" reads as 0.
    // The >= 0 floor is enforced here, not just in client code, because a
    // stale/racing client issuing a legal -1 step from an already-zero
    // counter would otherwise be able to drift it negative forever with no
    // way back — client-side clamping alone isn't a security boundary.
    function statsBefore(field) {
      return resource == null ? 0 : resource.data.get(field, 0);
    }
    function validCounter(field) {
      return request.resource.data.get(field, 0) >= 0
        && (request.resource.data.get(field, 0) == statsBefore(field)
          || request.resource.data.get(field, 0) == statsBefore(field) + 1
          || request.resource.data.get(field, 0) == statsBefore(field) - 1);
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if request.resource.data.activity is string
        && request.resource.data.status in ['Did it', 'Want to try', 'Not for me']
        && request.resource.data.story is string
        && request.resource.data.story.size() < 500;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /favorites/{activitySlug} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /doneRecords/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid
        && request.auth.uid == request.resource.data.uid;
    }

    match /activityStats/{slug} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['doneCount', 'saveCount'])
        && validCounter('doneCount')
        && validCounter('saveCount');
    }
  }
}
